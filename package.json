{
  "name": "awesome-code-video",
  "private": true,
  "description": "Curated reusable styles, shots, templates, and frameworks for making videos with code.",
  "type": "module",
  "scripts": {
    "lint": "awesome-lint README.md",
    "catalog": "node scripts/catalog.mjs",
    "catalog:check": "node scripts/catalog.mjs check",
    "readme:check": "node scripts/check-readme.mjs",
    "traceability:check": "node scripts/traceability.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run catalog:check && npm run readme:check && npm run traceability:check && npm test && npm run lint",
    "dev": "vite",
    "build": "tsx scripts/build-web.ts",
    "preview": "node scripts/serve-web.mjs",
    "typecheck": "tsc --noEmit",
    "test:web": "tsx --test tests/web.test.ts",
    "check:web": "npm run typecheck && npm run test:web && npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "awesome-lint": "2.3.0",
    "js-traceability": "0.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "CC0-1.0",
  "repository": "github:imjszhang/awesome-code-video",
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
